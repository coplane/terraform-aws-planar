extensions:
  health_check:
    endpoint: 0.0.0.0:13133

receivers:
  otlp:
    protocols:
      grpc:
        endpoint: 0.0.0.0:4317
      http:
        endpoint: 0.0.0.0:4318
%{ if enable_ecs_container_metrics ~}
  awsecscontainermetrics: {}
%{ endif ~}
%{ if enable_database_metrics ~}
  postgresql:
    endpoint: ${rds_endpoint}:5432
    transport: tcp
    username: ${otel_db_user}
    password: $${env:OTEL_DB_PASSWORD}
    databases: [appdb]
    collection_interval: 60s
    tls:
      insecure: false
      insecure_skip_verify: false
  sqlquery:
    driver: postgres
    datasource: "host=${rds_endpoint} port=5432 user=${otel_db_user} password=$${env:OTEL_DB_PASSWORD} dbname=appdb sslmode=require"
    collection_interval: 60s
    queries:
      - sql: |
          SELECT
            queryid::text AS query_id,
            calls,
            total_exec_time,
            mean_exec_time,
            rows
          FROM pg_stat_statements
          ORDER BY total_exec_time DESC
          LIMIT 50
        metrics:
          - metric_name: postgresql.query.calls
            value_column: calls
            attribute_columns: [query_id]
            value_type: int
            data_type: sum
            monotonic: true
          - metric_name: postgresql.query.total_exec_time_ms
            value_column: total_exec_time
            attribute_columns: [query_id]
            data_type: sum
          - metric_name: postgresql.query.mean_exec_time_ms
            value_column: mean_exec_time
            attribute_columns: [query_id]
            data_type: gauge
          - metric_name: postgresql.query.rows
            value_column: rows
            attribute_columns: [query_id]
            value_type: int
            data_type: sum
            monotonic: true
%{ endif ~}

processors:
%{ if enable_ecs_container_metrics ~}
  filter/ecs_metrics:
    metrics:
      include:
        match_type: strict
        metric_names:
          - ecs.task.cpu.reserved
          - ecs.task.cpu.utilized
          - ecs.task.cpu.usage.vcpu
          - ecs.task.memory.reserved
          - ecs.task.memory.utilized
          - ecs.task.memory.usage
          - ecs.task.memory.usage.limit
          - ecs.task.network.rate.rx
          - ecs.task.network.rate.tx
          - ecs.task.network.io.usage.rx_bytes
          - ecs.task.network.io.usage.tx_bytes
          - ecs.task.storage.read_bytes
          - ecs.task.storage.write_bytes
          - ecs.task.ephemeral_storage.utilized
          - ecs.task.ephemeral_storage.reserved
          - container.cpu.reserved
          - container.cpu.utilized
          - container.cpu.usage.vcpu
          - container.memory.reserved
          - container.memory.utilized
          - container.memory.usage
          - container.memory.usage.limit
          - container.network.rate.rx
          - container.network.rate.tx
          - container.network.io.usage.rx_bytes
          - container.network.io.usage.tx_bytes
          - container.storage.read_bytes
          - container.storage.write_bytes
  resource/ecs_tags:
    attributes:
      - key: service.name
        value: ${service_name}
        action: upsert
      - key: customer.name
        value: ${customer_name}
        action: upsert
      - key: deployment.environment
        value: ${stage}
        action: upsert
%{ endif ~}
  batch: {}

exporters:
  otlphttp/gateway:
    endpoint: ${metrics_endpoint}
    headers:
      authorization: "Bearer ${telemetry_token}"
%{ if enable_ecs_container_metrics ~}
  otlphttp/ecs:
    endpoint: ${metrics_endpoint}
    headers:
      authorization: "Bearer ${telemetry_token}"
%{ endif ~}
%{ if enable_logs_pipeline ~}
  otlphttp/logs:
    endpoint: ${metrics_endpoint}
    headers:
      authorization: "Bearer ${telemetry_token}"
%{ endif ~}
%{ if enable_database_metrics ~}
  otlphttp/db:
    endpoint: ${metrics_endpoint}
    headers:
      authorization: "Bearer ${telemetry_token}"
%{ endif ~}

service:
  extensions: [health_check]
  pipelines:
    metrics/app:
      receivers: [otlp]
      processors: [batch]
      exporters: [otlphttp/gateway]
%{ if enable_ecs_container_metrics ~}
    metrics/ecs:
      receivers: [awsecscontainermetrics]
      processors: [filter/ecs_metrics, resource/ecs_tags, batch]
      exporters: [otlphttp/ecs]
%{ endif ~}
    traces:
      receivers: [otlp]
      processors: [batch]
      exporters: [otlphttp/gateway]
%{ if enable_logs_pipeline ~}
    logs:
      receivers: [otlp]
      processors: [batch]
      exporters: [otlphttp/logs]
%{ endif ~}
%{ if enable_database_metrics ~}
    metrics/db:
      receivers: [postgresql, sqlquery]
      processors: [batch]
      exporters: [otlphttp/db]
%{ endif ~}
